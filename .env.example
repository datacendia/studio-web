# Copy to .env.local for development. Every variable the code reads is listed here.

# Admin sign-in. 32+ random characters; production refuses to open the admin without it.
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_COOKIE_SECRET=

# Where enquiries.json and users.json live. On Railway: /data (the mounted volume).
ADMIN_DATA_DIR=

# Email alerts for new enquiries (all three, or alerts stay off and the admin says so).
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Built & Booked <enquiries@yourdomain.com.au>"
ENQUIRY_FROM=
# Comma-separated: who gets the alert, e.g. stuart@...,evelyn@...
ENQUIRY_NOTIFY_TO=

# The public address, no trailing slash. Used for links in alerts, metadata and the sitemap.
SITE_URL=

# "1" lets search engines index the site. Leave unset until the studio name is final.
SITE_INDEXABLE=

# The reply promise is checked in this zone. Default Australia/Sydney.
STUDIO_TIMEZONE=
